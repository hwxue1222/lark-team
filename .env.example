# Lark / Feishu
LARK_APP_ID=
LARK_APP_SECRET=

# Use Lark (international) or Feishu (China)
# LARK_DOMAIN=https://open.larksuite.com
# LARK_DOMAIN=https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Kimi
KIMI_API_KEY=
KIMI_MODEL=k3
KIMI_BASE_URL=https://api.kimi.ai/coding/v1

# HTTP health server
HTTP_PORT=8000
LOG_LEVEL=INFO

# Local Agent (runs on your own computer)
LOCAL_AGENT_ENABLED=false
LOCAL_AGENT_URL=http://127.0.0.1:9100
LOCAL_AGENT_TOKEN=
LOCAL_AGENT_OPERATOR_IDS=

# Local Agent server-side settings (for scripts/start_local_agent.py)
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=9100
LOCAL_AGENT_ALLOWED_DOMAINS=bby.today,open.larksuite.com

# Accountant Agent (BBYAccounting)
ACCOUNTANT_ENABLED=false
BBY_ACCOUNTING_BASE_URL=https://bbyaccounting.com
BBY_ACCOUNTING_EMAIL=
BBY_ACCOUNTING_PASSWORD=
BBY_ACCOUNTING_ORG_ID=
ACCOUNTANT_OPERATOR_IDS=
ACCOUNTANT_DEFAULT_CURRENCY=SGD
ACCOUNTANT_DEFAULT_FX_RATE=1
